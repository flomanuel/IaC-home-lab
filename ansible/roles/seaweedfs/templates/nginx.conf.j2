# Managed by Ansible (roles/seaweedfs).
# TLS termination for SeaweedFS (weed mini, loopback only).
# Listening on explicit IPs keeps S3 on the data VLAN and the UIs on the mgmt
# VLAN, and avoids clashing with weed's own 127.0.0.1 listeners on the same ports.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;

events {
  worker_connections 1024;
}

http {
  access_log /var/log/nginx/access.log;

  ssl_certificate     /etc/letsencrypt/live/seaweedfs/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/seaweedfs/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:SSL:10m;

  proxy_http_version 1.1;
  # Pass the client's Host (incl. port) unchanged: it is part of the S3 SigV4 signature.
  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;

  # Objects can be arbitrarily large; stream them instead of buffering.
  client_max_body_size    0;
  proxy_request_buffering off;
  proxy_buffering         off;

  # S3 API (data VLAN)
  server {
    listen {{ seaweedfs_data_ip }}:443 ssl;
    listen {{ seaweedfs_data_ip }}:8333 ssl;
    server_name {{ seaweedfs_data_fqdn }};

    location / {
      proxy_pass http://127.0.0.1:8333;
    }
  }

  # Admin UI (mgmt VLAN). Login: admin / seaweedfs_admin_password.
  server {
    listen {{ seaweedfs_mgmt_ip }}:23646 ssl;
    server_name {{ seaweedfs_mgmt_fqdn }};

    location / {
      proxy_pass http://127.0.0.1:23646;
    }
  }

  # Filer UI (mgmt VLAN). No auth: this is the filer's full HTTP API.
  server {
    listen {{ seaweedfs_mgmt_ip }}:8888 ssl;
    server_name {{ seaweedfs_mgmt_fqdn }};

    location / {
      proxy_pass http://127.0.0.1:8888;
    }
  }
}
