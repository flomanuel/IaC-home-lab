---
# Copy to secrets.yml (gitignored) and fill in.
# Secrets of the docker stacks (postgres, pgAdmin, traefik, backup) live in Dockhand,
# see docs/runbooks/dockhand.md.

# ------ SeaweedFS ------
# S3 admin identity (truenas_lxc.yml).
seaweedfs_s3_access_key: CHANGEME
seaweedfs_s3_secret_key: CHANGEME
# Admin UI login (user "admin"), served on the mgmt VLAN.
seaweedfs_admin_password: CHANGEME

# ------ Cloudflare API token ------
# with Zone:DNS:Edit on sauers.link, used by certbot for DNS challenge.
# (traefik gets its copy as the Dockhand stack secret CF_DNS_API_TOKEN)
cloudflare_dns_api_token: CHANGEME

# ------ Dockhand ------
# Encrypts the stack secrets in Dockhand's DB. Without it, a restored backup of
# /opt/dockhand/data cannot decrypt them. Generate: openssl rand -base64 32
dockhand_encryption_key: CHANGEME
# Shared by the hawser agents and Dockhand (Settings > Environments > <host>).
# Generate: openssl rand -hex 32
hawser_token: CHANGEME
