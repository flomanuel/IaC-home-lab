---
# Copy to secrets.yml (gitignored) and fill in.

# SeaweedFS S3 admin identity (truenas_s3.yml).
seaweedfs_s3_access_key: CHANGEME
seaweedfs_s3_secret_key: CHANGEME
# SeaweedFS Admin UI login (user "admin"), served on the mgmt VLAN.
seaweedfs_admin_password: CHANGEME

# Cloudflare API token with Zone:DNS:Edit on sauers.link, used by certbot
# for the Let's Encrypt DNS-01 challenge.
cloudflare_dns_api_token: CHANGEME

# PostgreSQL superuser "postgres" (compose/postgres, debian-01). Only applied
# when the data directory is initialized; change it via ALTER USER afterwards.
postgres_password: CHANGEME
# pgAdmin login, served on debian-01's MGMT address, port 5050.
pgadmin_email: admin@example.com
pgadmin_password: CHANGEME
