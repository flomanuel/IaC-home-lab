---
# Copy to secrets.yml (gitignored) and fill in.

# ------ SeaweedFS ------
# S3 admin identity (truenas_lxc.yml).
seaweedfs_s3_access_key: CHANGEME
seaweedfs_s3_secret_key: CHANGEME
# Admin UI login (user "admin"), served on the mgmt VLAN.
seaweedfs_admin_password: CHANGEME

# ------ Cloudflare API token ------
# with Zone:DNS:Edit on sauers.link, used by certbot for DNS challenge.
cloudflare_dns_api_token: CHANGEME

# ------ PostgreSQL ------
# superuser "postgres"
postgres_password: CHANGEME
# pgAdmin login, served on debian-01's MGMT address, port 5050.
pgadmin_email: admin@example.com
pgadmin_password: CHANGEME

# ------ Backup config for offen/docker-volume-backup ------
backup_s3_endpoint: s3.example.com
backup_s3_bucket: CHANGEME
backup_s3_access_key: CHANGEME
backup_s3_secret_key: CHANGEME
# Symmetric GPG passphrase for the archives
backup_gpg_passphrase: CHANGEME

# Optional comma-separated shoutrrr URLs (https://shoutrrr.dev), notified on
# failed backups. Empty disables notifications.
backup_notification_urls: ""
