# Copy-me template for a new Linux VM:
#   1. cp vm_example.tf.disabled vm_<name>.tf
#   2. Replace "example" everywhere, pick VLAN(s) and a free IP
#   3. just plan && just apply
#   4. Add the VM to ansible/inventory/hosts.yml (+ host_vars if needed)
#   5. just play-limit base <name>   (once SSH access to the VLAN exists)
# Full walkthrough: docs/runbooks/new-vm.md

module "example" {
  source = "./modules/vm"
  common = local.common

  name  = "example"
  image = "debian" # or "ubuntu"
  # snippet = "qemu_guest_agent_debian"
  # agent_enabled = true # enable if qemu guest agent gets installed

  # First entry = primary NIC, gets the default gateway.
  # Add a second entry in VLAN "data" only if this VM needs TrueNAS NFS.
  networks = [
    { vlan = "prod", ip = "10.50.1.10/16" },
    # { vlan = "data", ip = "10.30.1.10/16" },
  ]

  cores   = 2
  memory  = 2048 # MiB
  disk_gb = 20

  # Optional:
  # vm_id = 150
  # tags  = ["docker"]

  # Optional: attach shared groups defined once in tofu/firewall.tf.
  # global_security_groups = ["ssh", "http", "https"]

  # Optional: this VM's own one-off rules (not shared with other VMs). The
  # label (e.g. "nfs4") is not a Proxmox object, just a readability grouping.
  # custom_firewall_rules = {
  #   nfs4 = [
  #     { type = "in", action = "ACCEPT", proto = "tcp", dport = "2049", comment = "NFSv4", iface = "net1" },
  #   ]
  # }

  # Leaving both unset keeps the Proxmox firewall disabled for this VM.
}

output "example" {
  value = module.example.summary
}

